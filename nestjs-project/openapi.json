            "name": "publicId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Upload aborted and draft deleted"
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Video not found or owned by another user's channel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "The video is not in draft status (upload not in progress)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Abort an upload",
        "tags": [
          "videos"
        ]
      }
    }
  },
  "info": {
    "title": "StreamTube API",
    "description": "API REST do StreamTube",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {}
      },
      "ResendConfirmationDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {}
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "InitiateUploadDto": {
        "type": "object",
        "properties": {}
      },
      "VideoMetadataResponse": {
        "type": "object",
        "properties": {
          "formatName": {
            "type": "string",
            "example": "mov,mp4,m4a,3gp,3g2,mj2"
          },
          "bitRate": {
            "type": "number",
            "nullable": true,
            "example": 1200000
          },
          "width": {
            "type": "number",
            "nullable": true,
            "example": 1920
          },
          "height": {
            "type": "number",
            "nullable": true,
            "example": 1080
          },
          "frameRate": {
            "type": "number",
            "nullable": true,
            "example": 30
          },
          "videoCodec": {
            "type": "string",
            "nullable": true,
            "example": "h264"
          },
          "audioCodec": {
            "type": "string",
            "nullable": true,
            "example": "aac"
          }
        },
        "required": [
          "formatName",
          "bitRate",
          "width",
          "height",
          "frameRate",
          "videoCodec",
          "audioCodec"
        ]
      },
      "VideoResponse": {
        "type": "object",
        "properties": {
          "public_id": {
            "type": "string",
            "example": "dQw4w9WgXcQ",
            "minLength": 11,
            "maxLength": 11
          },
          "title": {
            "type": "string",
            "example": "My first video"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "processing",
              "ready",
              "failed"
            ],
            "example": "draft"
          },
          "original_filename": {
            "type": "string",
            "example": "clip.mp4"
          },
          "content_type": {
            "type": "string",
            "example": "video/mp4"
          },
          "size_bytes": {
            "type": "number",
            "example": 5242880
          },
          "duration_seconds": {
            "type": "number",
            "nullable": true,
            "example": 12.5
          },
          "metadata": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/VideoMetadataResponse"
              }
            ]
          },
          "has_thumbnail": {
            "type": "boolean",
            "example": false
          },
          "failure_reason": {
            "type": "string",
            "nullable": true,
            "example": null
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "public_id",
          "title",
          "status",
          "original_filename",
          "content_type",
          "size_bytes",
          "duration_seconds",
          "metadata",
          "has_thumbnail",
          "failure_reason",
          "created_at",
          "updated_at"
        ]
      },
      "UploadPlanResponse": {
        "type": "object",
        "properties": {
          "part_size_bytes": {
            "type": "number",
            "example": 104857600
          },
          "part_count": {
            "type": "number",
            "example": 1
          },
          "max_part_urls_per_request": {
            "type": "number",
            "example": 100
          }
        },
        "required": [
          "part_size_bytes",
          "part_count",
          "max_part_urls_per_request"
        ]
      },
      "InitiateUploadResponse": {
        "type": "object",
        "properties": {
          "video": {
            "$ref": "#/components/schemas/VideoResponse"
          },
          "upload": {
            "$ref": "#/components/schemas/UploadPlanResponse"
          }
        },
        "required": [
          "video",
          "upload"
        ]
      },
      "RequestPartUrlsDto": {
        "type": "object",
        "properties": {}
      },
      "PartUrlResponse": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number",
            "example": 1
          },
          "url": {
            "type": "string",
            "description": "Presigned UploadPart URL; send the part bytes with PUT",
            "example": "http://localhost:9000/streamtube-videos/videos/…/source?…"
          }
        },
        "required": [
          "part_number",
          "url"
        ]
      },
      "PartUrlsResponse": {
        "type": "object",
        "properties": {
          "urls": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PartUrlResponse"
            }
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "urls",
          "expires_at"
        ]
      },
      "UploadedPartResponse": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number",
            "example": 1
          },
          "etag": {
            "type": "string",
            "example": "\"5d41402abc4b2a76b9719d911017c592\""
          },
          "size_bytes": {
            "type": "number",
            "example": 104857600
          }
        },
        "required": [
          "part_number",
          "etag",
          "size_bytes"
        ]
      },
      "UploadedPartsResponse": {
        "type": "object",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadedPartResponse"
            }
          }
        },
        "required": [
          "parts"
        ]
      },
      "CompleteUploadDto": {
        "type": "object",
        "properties": {}
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
    }
  }
}